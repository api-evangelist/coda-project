{
  "opencollection": "1.0.0",
  "info": {
    "name": "Superhuman Docs Admin Account API",
    "version": "0.0.2"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Account",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get user info",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://docs.superhuman.com/apis/admin/v1/whoami"
          },
          "docs": "Returns basic info about the current user."
        }
      ]
    }
  ],
  "bundled": true
}