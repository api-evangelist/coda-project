{
  "opencollection": "1.0.0",
  "info": {
    "name": "Superhuman Docs Admin Account Controls API",
    "version": "0.0.2"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Controls",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List controls",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://docs.superhuman.com/apis/admin/v1/docs/:docId/controls",
            "params": [
              {
                "name": "docId",
                "value": "AbCDeFGH",
                "type": "path",
                "description": "ID of the doc."
              },
              {
                "name": "limit",
                "value": "10",
                "type": "query",
                "description": "Maximum number of results to return in this query."
              },
              {
                "name": "pageToken",
                "value": "eyJsaW1pd",
                "type": "query",
                "description": "An opaque token used to fetch the next page of results."
              },
              {
                "name": "sortBy",
                "value": "name",
                "type": "query",
                "description": "Determines how to sort the given objects."
              }
            ]
          },
          "docs": "Returns a list of controls in a document."
        },
        {
          "info": {
            "name": "Get a control",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://docs.superhuman.com/apis/admin/v1/docs/:docId/controls/:controlIdOrName",
            "params": [
              {
                "name": "docId",
                "value": "AbCDeFGH",
                "type": "path",
                "description": "ID of the doc."
              },
              {
                "name": "controlIdOrName",
                "value": "ctrl-cDefGhij",
                "type": "path",
                "description": "ID or name of the control. Names are discouraged because they're easily prone to being changed by users. If you're using a name, be sure to URI-encode it."
              }
            ]
          },
          "docs": "Returns info on a control."
        }
      ]
    }
  ],
  "bundled": true
}