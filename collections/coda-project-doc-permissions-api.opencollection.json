{
  "opencollection": "1.0.0",
  "info": {
    "name": "Superhuman Docs Admin Account Doc Permissions API",
    "version": "0.0.2"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
